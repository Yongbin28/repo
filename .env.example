# =============================================================================
# WaferPulse — Environment Configuration Template (.env)
# =============================================================================
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env

# Port for the Streamlit server (default: 8501)
STREAMLIT_SERVER_PORT=8501

# Headless mode for cloud server (true for AWS EC2/Linux servers)
STREAMLIT_SERVER_HEADLESS=true

# Server bind address (0.0.0.0 binds to all network interfaces)
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Authentication enforcement:
# Set to 'true' only if you want to bypass login during local development/tests
WAFERPULSE_AUTH_DISABLED=false

# Optional cloud storage sync (e.g. for archiving reports to AWS S3)
# S3_BUCKET=waferpulse-archive-bucket
